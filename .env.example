# Public browser configuration
VITE_TURNSTILE_SITE_KEY=

# OAuth client IDs are public, but remain configurable per environment
GITHUB_CLIENT_ID=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# OAuth callback URLs registered in the provider consoles
GITHUB_REDIRECT_URI=https://localhost:8788/auth/github
GOOGLE_REDIRECT_URI=https://localhost:8788/auth/Google/
MICROSOFT_REDIRECT_URI=https://localhost:8788/auth/microsoft

# Server-only secrets; never expose these through VITE_* variables
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_SESSION_SECRET=
